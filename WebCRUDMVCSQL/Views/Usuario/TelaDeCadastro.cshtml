@model WebCRUDMVCSQL.Models.Usuario

@{
    ViewBag.Title = "Trocar Senha";
    ViewBag.HideMenu = true;
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<style>
    body {
        background-color: #1a1a2e;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    h1 {
        color: #ffffff;
        margin-bottom: 1rem;
        text-align: center;
    }

    .col-md-4 {
        background-color: #ffffff;
        padding: 2rem;
        border-radius: 12px;
        width: 100%;
        max-width: 400px;
    }
</style>
<h1>Cadastro</h1>
<div style="display: flex; justify-content: center; width: 100%;">
    <div class="col-md-4">
        <form asp-action="TelaDeCadastro" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger">@ViewBag.Erro</div>
            }

            <div class="form-group">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Senha"></label>
                <input asp-for="Senha" class="form-control" type="password" />
                <span asp-validation-for="Senha" class="text-danger"></span>
            </div>
            <div class="form-btn-group mt-2">
                <input type="submit" value="Cadastrar" class="btn btn-primary" />
            </div>
            <div class="form-btn-group">
                <a asp-action="TelaDeLogin">Já tem uma conta? Faça login</a>
            </div>

        </form>
    </div>
</div>