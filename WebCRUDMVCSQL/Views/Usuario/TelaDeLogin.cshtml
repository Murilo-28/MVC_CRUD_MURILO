@model WebCRUDMVCSQL.Models.Usuario

@{
    ViewBag.Title = "Trocar Senha";
    ViewBag.HideMenu = true;
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<style>
    body {
        background-color: #1a1a2e;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    h1 {
        color: #ffffff;
        margin-bottom: 1rem;
        text-align: center;
    }

    .col-md-4 {
        background-color: #ffffff;
        padding: 2rem;
        border-radius: 12px;
        width: 100%;
        max-width: 400px;
    }
</style>
<h1>Login</h1>
<div style="display: flex; justify-content: center; width: 100%;">
    <div class="col-md-4">
        <form asp-action="TelaDeLogin" method="post">

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger">@ViewBag.Erro</div>
            }

            <div class="form-group">
                <label>Email</label>
                <input name="email" class="form-control" />
            </div>
            <div class="form-group">
                <label>Senha</label>
                <input name="senha" class="form-control" type="password" />
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Entrar" class="btn btn-primary" />
            </div>
            <div class="form-btn-group">
                <a asp-action="TelaDeCadastro">Não tem uma conta? Cadastre-se</a>
            </div>

        </form>
    </div>
</div>