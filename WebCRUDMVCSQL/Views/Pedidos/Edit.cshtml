@model WebCRUDMVCSQL.Models.Pedido

@{
    ViewData["Title"] = "Editar Pedido";
}

<h1>Editando Pedido</h1>

<div class="col-md-4">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label asp-for="IdCliente">Cliente</label>
            <select asp-for="IdCliente" class="form-control"
                    asp-items="@(ViewBag.Clientes as SelectList)">
                <option value="">Escolha um cliente</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="IdProduto">Produto</label>
            <select asp-for="IdProduto" class="form-control"
                    asp-items="@(ViewBag.Produtos as SelectList)">
                <option value="">Escolha um produto</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="Quantidade">Quantidade</label>
            <input asp-for="Quantidade" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Preco">Preço</label>
            <input asp-for="Preco" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>