@model WebCRUDMVCSQL.Models.Pedido

@{
    ViewData["Title"] = "Criar Pedido";
}

<h1>Criando Pedido</h1>
<div class="col-md-4">
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="NomeCliente">Cliente</label>
            <input asp-for="NomeCliente" class="form-control" placeholder="Digite o nome do cliente" />
        </div>

        <div class="form-group">
            <label asp-for="NomeProduto">Produto</label>
            <input asp-for="NomeProduto" class="form-control" placeholder="Digite o nome do produto" />

            <div class="form-group">
                <label asp-for="Quantidade"></label>
                <input asp-for="Quantidade" class="form-control" min="1" />
            </div>

            <div class="form-group">
                <label asp-for="Preco"></label>
                <input asp-for="Preco" class="form-control" readonly />
            </div>

            <button type="submit" name="acao" value="buscarPreco" class="btn btn-secondary mt-1">
                Buscar Preço
            </button>
        </div>

        @if (Model != null && Model.Preco > 0)
        {
            <div class="form-group mt-2">
                <input type="submit" name="acao" value="Criar Pedido" class="btn btn-primary" />
            </div>
        }
    </form>
</div>