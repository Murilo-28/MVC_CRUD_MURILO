@model WebCRUDMVCSQL.Models.Pedido

@{
    ViewData["Title"] = "Criar Pedido";
}

<h1>Criando Pedido</h1>
<div class="col-md-4">
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="IdCliente">Cliente</label>
            <select asp-for="IdCliente" class="form-control"
                    asp-items="@(ViewBag.Clientes as SelectList)">
                <option value="">Escolha um cliente</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="IdProduto">Produto</label>
            <select asp-for="IdProduto" class="form-control"
                    asp-items="@(ViewBag.Produtos as SelectList)">
                <option value="">Escolha um produto</option>
            </select>

            <div class="form-group">
                <label asp-for="Quantidade"></label>
                <input asp-for="Quantidade" class="form-control" min="1" />
            </div>

            <div class="form-group">
                <label asp-for="Preco"></label>
                <input asp-for="Preco" class="form-control" readonly />
            </div>

            <!-- Botão para buscar o preço -->
            <button type="submit" name="acao" value="buscarPreco"
                    class="btn btn-secondary mt-1">
                Buscar Preço
            </button>
        </div>

        @if (Model != null && Model.Preco > 0)
        {
            <div class="form-group mt-2">
                <input type="submit" name="acao" value="Criar Pedido"
                       class="btn btn-primary" />
            </div>
        }
    </form>
</div>